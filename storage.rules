rules_version = '2';

// Files are only reachable by signed-in @tigongolfcarts.com users, except through
// download URLs (tokenized), which storefronts and shares use for listing photos.
service firebase.storage {
  match /b/{bucket}/o {
    function isValidEmail() {
      return request.auth != null && request.auth.token.email.matches('.*@tigongolfcarts[.]com$');
    }
    function mpRole() {
      return firestore.get(/databases/(default)/documents/mp_users/$(request.auth.uid)).data.role;
    }
    function isMpMember() {
      return isValidEmail() && firestore.exists(/databases/(default)/documents/mp_users/$(request.auth.uid));
    }
    function isMpManager() {
      return isMpMember() && mpRole() in ['admin', 'manager'];
    }
    function isImageOrVideo() {
      return request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*');
    }

    // Listing photos and generated media, per user: mp_media/{uid}/...
    match /mp_media/{uid}/{allPaths=**} {
      allow read: if isMpMember();
      allow create, update: if isMpMember() && request.auth.uid == uid &&
                               request.resource.size < 25 * 1024 * 1024 && isImageOrVideo();
      allow delete: if isMpMember() && (request.auth.uid == uid || isMpManager());
    }

    // Shared brand library (logos, fonts, photos): managers upload.
    match /mp_assets/{allPaths=**} {
      allow read: if isMpMember();
      allow write: if isMpManager() && (request.resource == null || request.resource.size < 50 * 1024 * 1024);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

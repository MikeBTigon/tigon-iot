rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isValidEmail() {
      return request.auth != null && 
             request.auth.token.email.matches('.*@tigongolfcarts[.]com$');
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isValidEmail();
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Devices collection
    match /devices/{deviceId} {
      // MP managers/admins can see and manage (rename, reassign, revoke) every phone.
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isMpManager());
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       isValidEmail();
      allow update: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isMpManager());
      allow delete: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isMpAdmin());
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Owners see their own; MP managers/admins see every phone's notifications on the dashboard.
      allow read: if isAuthenticated() && 
                     (resource.data.targetUserId == request.auth.uid || isMpManager());
      allow create: if isAuthenticated() && isValidEmail();
      allow update: if isAuthenticated() && 
                       (resource.data.targetUserId == request.auth.uid || isMpManager());
      allow delete: if isAuthenticated() && 
                       resource.data.targetUserId == request.auth.uid;
    }
    
    // App versions (read-only for authenticated users)
    match /appVersions/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admins via console
    }
    
    // System config (read-only)
    match /systemConfig/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admins
    }

    // ---------------------------------------------------------------
    // Tigon MP Assistant (Facebook Marketplace posting) — parallel module
    // ---------------------------------------------------------------
    function mpProfilePath() {
      return /databases/$(database)/documents/mp_users/$(request.auth.uid);
    }

    function isMpMember() {
      return isValidEmail() && exists(mpProfilePath());
    }

    function isMpManager() {
      return isMpMember() && get(mpProfilePath()).data.role in ['admin', 'manager'];
    }

    function mpRequireApproval() {
      return exists(/databases/$(database)/documents/mp_settings/general) &&
             get(/databases/$(database)/documents/mp_settings/general).data.get('requireApproval', false) == true;
    }

    function isMpAdmin() {
      return isMpMember() && get(mpProfilePath()).data.role == 'admin';
    }

    // Bootstrap admins are listed in systemConfig/mpAssistant.adminEmails (console only).
    function isMpBootstrapAdmin() {
      return exists(/databases/$(database)/documents/systemConfig/mpAssistant) &&
             request.auth.token.email in
               get(/databases/$(database)/documents/systemConfig/mpAssistant).data.adminEmails;
    }

    match /mp_users/{userId} {
      allow read: if isValidEmail();
      allow create: if isValidEmail() && isOwner(userId) &&
                       request.resource.data.email == request.auth.token.email &&
                       (request.resource.data.role == 'sales' ||
                        (request.resource.data.role == 'admin' && isMpBootstrapAdmin()));
      allow update: if isMpAdmin() ||
                       (isValidEmail() && isOwner(userId) &&
                        request.resource.data.role == resource.data.role &&
                        request.resource.data.email == resource.data.email);
      allow delete: if isMpAdmin();
    }

    // Inventory synced from the DMS API by the mpSyncInventory / mpSyncNow functions (admin SDK).
    // Admins update posting fields and can remove carts.
    match /mp_carts/{cartId} {
      allow read: if isMpMember();
      allow write: if isMpAdmin();
      // Anyone on the team can record where they posted a cart, or mark it sold.
      allow update: if isMpMember() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['postedBy', 'postedAccounts', 'soldLocally', 'soldAt', 'soldBy']);
      // Listings created in the app (snap-to-list, CSV import) by team members.
      allow create: if isMpMember() && request.resource.data.source == 'manual' &&
                       request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isMpMember() && resource.data.source == 'manual' &&
                               (resource.data.createdBy == request.auth.uid || isMpManager());
    }

    // Sync status (written by functions only).
    match /mp_meta/{docId} {
      allow read: if isMpMember();
      allow write: if false;
    }

    // Posting queue: managers assign carts to people/phones; the assignee works the item.
    match /mp_queue/{itemId} {
      allow read: if isMpMember();
      // When approval is required, members' items start as 'pending_approval' and only a manager can release them.
      allow create: if isMpManager() ||
                       (isMpMember() && request.resource.data.assignedUserId == request.auth.uid &&
                        request.resource.data.createdBy == request.auth.uid &&
                        (!mpRequireApproval() || request.resource.data.status == 'pending_approval'));
      allow update: if isMpManager() ||
                       (isMpMember() && resource.data.assignedUserId == request.auth.uid &&
                        request.resource.data.assignedUserId == request.auth.uid &&
                        (resource.data.status != 'pending_approval' ||
                         request.resource.data.status in ['pending_approval', 'cancelled']) &&
                        // With approval on, members can't put an item back in line themselves.
                        (!mpRequireApproval() || request.resource.data.status != 'queued' ||
                         resource.data.status == 'queued'));
      allow delete: if isMpManager();
    }

    // Analytics events (append-only) and per-device daily activity.
    match /mp_events/{eventId} {
      allow read: if isMpManager() || (isMpMember() && resource.data.userId == request.auth.uid);
      allow create: if isMpMember() && request.resource.data.userId == request.auth.uid;
    }
    match /mp_device_days/{dayId} {
      allow read: if isMpManager() || (isMpMember() && resource.data.userId == request.auth.uid);
      allow create, update: if isMpMember() && request.resource.data.userId == request.auth.uid;
    }

    // Alerts are created by functions; managers can acknowledge them.
    match /mp_alerts/{alertId} {
      allow read: if isMpManager();
      allow update: if isMpManager() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['acknowledgedBy', 'acknowledgedAt']);
    }

    // Audit log: append-only, admins read.
    match /mp_audit/{entryId} {
      allow read: if isMpAdmin();
      allow create: if isMpMember() && request.resource.data.actorUid == request.auth.uid;
    }

    // Pairing codes are only ever touched by Cloud Functions.
    match /mp_pairing/{codeId} {
      allow read, write: if false;
    }

    // ---- Growth release --------------------------------------------------

    // Team settings (approval workflow, logo, relist days).
    match /mp_settings/{docId} {
      allow read: if isMpMember();
      allow write: if isMpAdmin();
    }

    // Listing and reply templates: shared ones readable by all, owners/managers edit.
    match /mp_templates/{id} {
      allow read: if isMpMember();
      allow create: if isMpMember() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isMpMember() && (resource.data.createdBy == request.auth.uid || isMpManager());
    }

    // Import connectors; credentials are in mp_integration_secrets and only functions read them.
    match /mp_integrations/{id} {
      allow read: if isMpManager();
      allow write: if isMpAdmin();
    }
    match /mp_integration_secrets/{id} {
      allow read: if false;
      allow create, update, delete: if isMpAdmin();
    }

    // Tracked short links (clicks are counted by the mpLink function).
    match /mp_links/{code} {
      allow read: if isMpMember();
      allow create: if isMpMember() && request.resource.data.userId == request.auth.uid &&
                       request.resource.data.clicks == 0;
      allow delete: if isMpManager();
    }
    match /mp_clicks/{id} {
      allow read: if isMpManager() || (isMpMember() && resource.data.userId == request.auth.uid);
    }

    // Public mini-storefronts (served publicly by the mpStorefrontApi function).
    match /mp_storefronts/{slug} {
      allow read: if isMpMember();
      allow create: if isMpMember() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isMpMember() && (resource.data.userId == request.auth.uid || isMpManager()) &&
                               request.resource.data.userId == resource.data.userId;
    }

    // Leads: owners and managers.
    match /mp_leads/{id} {
      allow read: if isMpManager() || (isMpMember() && resource.data.ownerUid == request.auth.uid);
      allow create: if isMpMember() && (request.resource.data.ownerUid == request.auth.uid || isMpManager());
      allow update: if isMpManager() ||
                       (isMpMember() && resource.data.ownerUid == request.auth.uid &&
                        request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isMpManager();
    }

    // Customers (opt-in consent tracked per channel), shared by the team.
    match /mp_customers/{id} {
      allow read, create, update: if isMpMember();
      allow delete: if isMpManager();
    }

    // Goals set by managers.
    match /mp_goals/{id} {
      allow read: if isMpMember();
      allow write: if isMpManager();
    }

    // Brand asset library.
    match /mp_assets/{id} {
      allow read: if isMpMember();
      allow write: if isMpManager();
    }

    // Facebook posting accounts.
    match /mp_accounts/{accountId} {
      allow read: if isMpMember();
      allow write: if isMpAdmin();
    }

    // ---- Webhook Flows (website forms → flows) -----------------------------
    // Managers run websites, webhooks, flows and email templates; admins own global settings and
    // integrations. Submissions and step runs are written only by Cloud Functions.
    match /wh_domains/{id} {
      allow read, write: if isMpManager();
    }
    match /wh_webhooks/{id} {
      allow read, write: if isMpManager();
    }
    match /wh_flows/{id} {
      allow read: if isMpManager();
      // Only admins may change the Master Flow (every lead passes through it).
      allow create: if isMpAdmin() || (isMpManager() && request.resource.data.type != 'master');
      allow update: if isMpAdmin() ||
                       (isMpManager() && resource.data.type != 'master' && request.resource.data.type != 'master');
      allow delete: if isMpAdmin() || (isMpManager() && resource.data.type != 'master');
    }
    match /wh_email_templates/{id} {
      allow read, write: if isMpManager();
    }
    match /wh_submissions/{id} {
      allow read: if isMpManager();
      // Managers may flag a lead (spam / not spam, notes); the engine owns everything else.
      allow update: if isMpManager() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['isSpam', 'spamReason', 'status', 'notes', 'reviewedBy', 'reviewedAt']);
      allow delete: if isMpAdmin();
    }
    match /wh_step_runs/{id} {
      allow read: if isMpManager();
    }
    match /wh_stats/{id} {
      allow read: if isMpManager();
    }
    match /wh_settings/{id} {
      allow read: if isMpManager();
      allow write: if isMpAdmin();
    }
    match /wh_integrations/{id} {
      allow read: if isMpManager();
      allow write: if isMpAdmin();
    }
    // Credentials: write-only from the app, read only by Cloud Functions. Managers may set the
    // HMAC signing secret of a webhook (id "webhook_<webhookId>").
    match /wh_integration_secrets/{id} {
      allow read: if false;
      allow create, update, delete: if isMpAdmin() || (isMpManager() && id.matches('webhook_.*'));
    }
    match /wh_sheet_buffer/{id} {
      allow read, write: if false;
    }
    match /wh_rate/{id} {
      allow read, write: if false;
    }
  }
}
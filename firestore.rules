rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isValidEmail() {
      return request.auth != null && 
             request.auth.token.email.matches('.*@tigongolfcarts[.]com$');
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isValidEmail();
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Devices collection
    match /devices/{deviceId} {
      // MP managers/admins can see and manage (rename, reassign, revoke) every phone.
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isMpManager());
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       isValidEmail();
      allow update: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isMpManager());
      allow delete: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isMpAdmin());
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && 
                     resource.data.targetUserId == request.auth.uid;
      allow create: if isAuthenticated() && isValidEmail();
      allow update: if isAuthenticated() && 
                       resource.data.targetUserId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                       resource.data.targetUserId == request.auth.uid;
    }
    
    // App versions (read-only for authenticated users)
    match /appVersions/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admins via console
    }
    
    // System config (read-only)
    match /systemConfig/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admins
    }

    // ---------------------------------------------------------------
    // Tigon MP Assistant (Facebook Marketplace posting) — parallel module
    // ---------------------------------------------------------------
    function mpProfilePath() {
      return /databases/$(database)/documents/mp_users/$(request.auth.uid);
    }

    function isMpMember() {
      return isValidEmail() && exists(mpProfilePath());
    }

    function isMpManager() {
      return isMpMember() && get(mpProfilePath()).data.role in ['admin', 'manager'];
    }

    function isMpAdmin() {
      return isMpMember() && get(mpProfilePath()).data.role == 'admin';
    }

    // Bootstrap admins are listed in systemConfig/mpAssistant.adminEmails (console only).
    function isMpBootstrapAdmin() {
      return exists(/databases/$(database)/documents/systemConfig/mpAssistant) &&
             request.auth.token.email in
               get(/databases/$(database)/documents/systemConfig/mpAssistant).data.adminEmails;
    }

    match /mp_users/{userId} {
      allow read: if isValidEmail();
      allow create: if isValidEmail() && isOwner(userId) &&
                       request.resource.data.email == request.auth.token.email &&
                       (request.resource.data.role == 'sales' ||
                        (request.resource.data.role == 'admin' && isMpBootstrapAdmin()));
      allow update: if isMpAdmin() ||
                       (isValidEmail() && isOwner(userId) &&
                        request.resource.data.role == resource.data.role &&
                        request.resource.data.email == resource.data.email);
      allow delete: if isMpAdmin();
    }

    // Inventory synced from the DMS API by the mpSyncInventory / mpSyncNow functions (admin SDK).
    // Admins update posting fields and can remove carts.
    match /mp_carts/{cartId} {
      allow read: if isMpMember();
      allow write: if isMpAdmin();
      // Anyone on the team can record where they posted a cart.
      allow update: if isMpMember() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['postedBy', 'postedAccounts']);
    }

    // Sync status (written by functions only).
    match /mp_meta/{docId} {
      allow read: if isMpMember();
      allow write: if false;
    }

    // Posting queue: managers assign carts to people/phones; the assignee works the item.
    match /mp_queue/{itemId} {
      allow read: if isMpMember();
      allow create: if isMpManager() ||
                       (isMpMember() && request.resource.data.assignedUserId == request.auth.uid &&
                        request.resource.data.createdBy == request.auth.uid);
      allow update: if isMpManager() ||
                       (isMpMember() && resource.data.assignedUserId == request.auth.uid &&
                        request.resource.data.assignedUserId == request.auth.uid);
      allow delete: if isMpManager();
    }

    // Analytics events (append-only) and per-device daily activity.
    match /mp_events/{eventId} {
      allow read: if isMpManager() || (isMpMember() && resource.data.userId == request.auth.uid);
      allow create: if isMpMember() && request.resource.data.userId == request.auth.uid;
    }
    match /mp_device_days/{dayId} {
      allow read: if isMpManager() || (isMpMember() && resource.data.userId == request.auth.uid);
      allow create, update: if isMpMember() && request.resource.data.userId == request.auth.uid;
    }

    // Alerts are created by functions; managers can acknowledge them.
    match /mp_alerts/{alertId} {
      allow read: if isMpManager();
      allow update: if isMpManager() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['acknowledgedBy', 'acknowledgedAt']);
    }

    // Audit log: append-only, admins read.
    match /mp_audit/{entryId} {
      allow read: if isMpAdmin();
      allow create: if isMpMember() && request.resource.data.actorUid == request.auth.uid;
    }

    // Pairing codes are only ever touched by Cloud Functions.
    match /mp_pairing/{codeId} {
      allow read, write: if false;
    }

    // Facebook posting accounts.
    match /mp_accounts/{accountId} {
      allow read: if isMpMember();
      allow write: if isMpAdmin();
    }
  }
}
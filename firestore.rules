rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // A signed-in @tigongolfcarts.com account whose email is verified (the app's VerifyEmailGate already
    // requires this; phones set up with a QR code are marked verified by mpPairDevice).
    function isValidEmail() {
      return request.auth != null &&
             request.auth.token.email.matches('.*@tigongolfcarts[.]com$') &&
             request.auth.token.email_verified == true;
    }

    // Same address check without verification — only for a person's own users/{uid} profile doc.
    function isCompanyEmail() {
      return request.auth != null &&
             request.auth.token.email.matches('.*@tigongolfcarts[.]com$');
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection (IoT login record). Normally written by the createUserDocument function (admin SDK);
    // a just-signed-up, not-yet-verified person may still create their own doc — it grants nothing.
    // Nobody can give themselves a role or mark themselves verified.
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isCompanyEmail() &&
                       request.resource.data.get('role', 'user') == 'user' &&
                       request.resource.data.get('emailVerified', false) == false;
      allow update: if isAuthenticated() && isOwner(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'emailVerified', 'email']);
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Devices collection
    // Fields the phone app writes for its own record (native/deviceSession.ts registerDevice + heartbeat,
    // native/phoneAlerts.ts, the Devices page rename). Everything else — userId (reassign), status (revoke),
    // deviceNumber/locationId/accountId, echoSecretHash/echoRegisteredAt, pushError… — is for managers or
    // Cloud Functions only.
    function deviceOwnerFields() {
      return ['deviceName', 'lastSeen', 'fcmToken', 'platform', 'model', 'osVersion', 'appVersion',
              'isActive', 'updatedAt'];
    }
    function deviceCreateFields() {
      return deviceOwnerFields().concat(['userId', 'deviceType', 'source', 'installId', 'status', 'pairedAt']);
    }
    // registerDevice(): a phone retired only because it was set up for someone else comes back when its
    // owner signs in on it again (status revoked → active, retiredReason/replacedBy removed).
    function deviceSelfRestore() {
      return resource.data.get('status', '') == 'revoked' &&
             resource.data.get('retiredReason', '') == 'phone-set-up-again' &&
             request.resource.data.status == 'active' &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(deviceOwnerFields().concat(['status', 'retiredReason', 'replacedBy'])) &&
             !request.resource.data.keys().hasAny(['retiredReason', 'replacedBy']);
    }
    match /devices/{deviceId} {
      // MP managers/admins can see and manage (rename, reassign, revoke) every phone.
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid || isMpManager());
      allow create: if isValidEmail() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasOnly(deviceCreateFields()) &&
                       request.resource.data.get('status', 'active') == 'active' &&
                       request.resource.data.get('deviceType', 'master') == 'master' &&
                       request.resource.data.get('source', 'tigon-iot-app') == 'tigon-iot-app';
      allow update: if isMpManager() ||
                       (isValidEmail() && resource.data.userId == request.auth.uid &&
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(deviceOwnerFields()) ||
                         deviceSelfRestore()));
      allow delete: if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid || isMpAdmin());
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Owners see their own; MP managers/admins see every phone's notifications on the dashboard.
      allow read: if isAuthenticated() && 
                     (resource.data.targetUserId == request.auth.uid || isMpManager());
      // The server (phone forwarding, alerts) creates notifications for anyone; the app only for yourself.
      allow create: if isValidEmail() && request.resource.data.targetUserId == request.auth.uid;
      allow update: if isAuthenticated() && 
                       (resource.data.targetUserId == request.auth.uid || isMpManager());
      allow delete: if isAuthenticated() && 
                       resource.data.targetUserId == request.auth.uid;
    }
    
    // App versions (read-only for authenticated users)
    match /appVersions/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admins via console
    }
    
    // System config (read-only)
    match /systemConfig/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admins
    }

    // "Request a change" (sidebar): anyone on the team reports a bug or asks for a feature.
    // People see their own requests; admins and managers see all of them and set the status.
    match /change_requests/{id} {
      allow read: if isValidEmail() && (resource.data.createdBy == request.auth.uid || isMpManager());
      allow create: if isValidEmail() &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.status == 'new' &&
                       request.resource.data.kind in ['bug', 'feature', 'other'] &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150 &&
                       request.resource.data.details is string && request.resource.data.details.size() <= 5000 &&
                       request.resource.data.keys().hasOnly(['kind', 'title', 'details', 'where', 'status', 'createdBy',
                         'createdByName', 'createdByEmail', 'platform', 'createdAt']);
      allow update: if isMpManager() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isMpManager();
    }

    // ---------------------------------------------------------------
    // Tigon MP Assistant (Facebook Marketplace posting) — parallel module
    // ---------------------------------------------------------------
    function mpProfilePath() {
      return /databases/$(database)/documents/mp_users/$(request.auth.uid);
    }

    // A member has an mp_users profile that an admin approved. New sign-ups start as status 'pending';
    // offboarded people are set to 'disabled'. Profiles from before approvals existed have no status (= active).
    function isMpMember() {
      return isValidEmail() && exists(mpProfilePath()) &&
             !(get(mpProfilePath()).data.get('status', 'active') in ['pending', 'disabled']);
    }

    function isMpManager() {
      return isMpMember() && get(mpProfilePath()).data.role in ['admin', 'manager'];
    }

    function mpRequireApproval() {
      return exists(/databases/$(database)/documents/mp_settings/general) &&
             get(/databases/$(database)/documents/mp_settings/general).data.get('requireApproval', false) == true;
    }

    function isMpAdmin() {
      return isMpMember() && get(mpProfilePath()).data.role == 'admin';
    }

    // Bootstrap admins are listed in systemConfig/mpAssistant.adminEmails (console only).
    function isMpBootstrapAdmin() {
      return exists(/databases/$(database)/documents/systemConfig/mpAssistant) &&
             request.auth.token.email in
               get(/databases/$(database)/documents/systemConfig/mpAssistant).data.adminEmails;
    }

    match /mp_users/{userId} {
      allow read: if isValidEmail();
      // Self-enrolment (MpShell → ProfileSetup → saveProfile): a new member waits for an admin
      // (status 'pending'); a bootstrap admin (systemConfig/mpAssistant.adminEmails) starts active.
      // Once the doc exists (even 'disabled') this rule can't fire again, so an offboarded person can't
      // re-enrol; only an admin deleting the doc allows a fresh (pending) sign-up.
      allow create: if isValidEmail() && isOwner(userId) &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.keys().hasOnly(['email', 'name', 'legacyId', 'role', 'status', 'createdAt', 'updatedAt', 'prefs']) &&
                       ((request.resource.data.role == 'sales' && request.resource.data.get('status', '') == 'pending') ||
                        (request.resource.data.role == 'admin' && isMpBootstrapAdmin() &&
                         request.resource.data.get('status', 'active') in ['active', 'pending']));
      // Admins (Admin page) approve / reject / disable people and set roles.
      allow update: if isMpAdmin() ||
                       // Managers (Users page) may change a person's name and location.
                       (isMpManager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'location', 'updatedAt'])) ||
                       // Everyone may edit their own name, legacy identity and preferences — never their role,
                       // approval status, location or email. Disabled people can't edit anything.
                       (isValidEmail() && isOwner(userId) &&
                        resource.data.get('status', 'active') != 'disabled' &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'location', 'email']));
      allow delete: if isMpAdmin();
    }

    // Inventory synced from the DMS API by the mpSyncInventory / mpSyncNow functions (admin SDK).
    // Admins update posting fields and can remove carts.
    match /mp_carts/{cartId} {
      allow read: if isMpMember();
      allow write: if isMpAdmin();
      // Anyone on the team can record where they posted a cart, or mark it sold.
      allow update: if isMpMember() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['postedBy', 'postedAccounts', 'soldLocally', 'soldAt', 'soldBy', 'videos', 'videoUpdatedAt', 'doNotPost']);
      // Listings created in the app (snap-to-list, CSV import) by team members.
      allow create: if isMpMember() && request.resource.data.source == 'manual' &&
                       request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isMpMember() && resource.data.source == 'manual' &&
                               (resource.data.createdBy == request.auth.uid || isMpManager());
    }

    // Sync status (written by functions only).
    match /mp_meta/{docId} {
      allow read: if isMpMember();
      allow write: if false;
    }

    // Posting queue: managers assign carts to people/phones; the assignee works the item.
    match /mp_queue/{itemId} {
      allow read: if isMpMember();
      // When approval is required, members' items start as 'pending_approval' and only a manager can release them.
      allow create: if isMpManager() ||
                       (isMpMember() && request.resource.data.assignedUserId == request.auth.uid &&
                        request.resource.data.createdBy == request.auth.uid &&
                        (!mpRequireApproval() || request.resource.data.status == 'pending_approval'));
      allow update: if isMpManager() ||
                       (isMpMember() && resource.data.assignedUserId == request.auth.uid &&
                        request.resource.data.assignedUserId == request.auth.uid &&
                        (resource.data.status != 'pending_approval' ||
                         request.resource.data.status in ['pending_approval', 'cancelled']) &&
                        // With approval on, members can't put an item back in line themselves.
                        (!mpRequireApproval() || request.resource.data.status != 'queued' ||
                         resource.data.status == 'queued'));
      allow delete: if isMpManager();
    }

    // Analytics events (append-only) and per-device daily activity.
    match /mp_events/{eventId} {
      allow read: if isMpManager() || (isMpMember() && resource.data.userId == request.auth.uid);
      allow create: if isMpMember() && request.resource.data.userId == request.auth.uid;
    }
    // Phone online time per New York day (5-minute slots). Phones write their own; managers read all.
    match /mp_device_online/{dayId} {
      allow read: if isMpManager() || (isMpMember() && resource.data.userId == request.auth.uid);
      allow create, update: if isMpMember() && request.resource.data.userId == request.auth.uid &&
                               request.resource.data.keys().hasOnly(['deviceId', 'userId', 'date', 'slots', 'updatedAt']) &&
                               request.resource.data.slots is map;
    }

    match /mp_device_days/{dayId} {
      allow read: if isMpManager() || (isMpMember() && resource.data.userId == request.auth.uid);
      allow create, update: if isMpMember() && request.resource.data.userId == request.auth.uid;
    }

    // Alerts are created by functions; managers can acknowledge them.
    match /mp_alerts/{alertId} {
      allow read: if isMpManager();
      allow update: if isMpManager() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['acknowledgedBy', 'acknowledgedAt']);
      // System Triage → Delete.
      allow delete: if isMpManager();
    }

    // Audit log: append-only, admins read. The app's writeAudit() (mp/audit.ts) still appends entries in
    // the person's own name with a fixed shape; Cloud Functions add authoritative entries server-side.
    match /mp_audit/{entryId} {
      allow read: if isMpAdmin();
      allow create: if isMpMember() && request.resource.data.actorUid == request.auth.uid &&
                       request.resource.data.keys().hasOnly(['actorUid', 'actorName', 'action', 'target', 'details', 'ts']) &&
                       request.resource.data.keys().hasAll(['actorUid', 'action', 'ts']) &&
                       request.resource.data.action is string &&
                       request.resource.data.action.size() > 0 && request.resource.data.action.size() <= 100 &&
                       request.resource.data.get('actorName', '') is string && request.resource.data.get('actorName', '').size() <= 200 &&
                       request.resource.data.get('target', '') is string && request.resource.data.get('target', '').size() <= 500 &&
                       request.resource.data.get('details', '') is string && request.resource.data.get('details', '').size() <= 5000 &&
                       request.resource.data.ts is number;
    }

    // Pairing codes are only ever touched by Cloud Functions.
    match /mp_pairing/{codeId} {
      allow read, write: if false;
    }

    // ---- Growth release --------------------------------------------------

    // Team settings (approval workflow, logo, relist days).
    match /mp_settings/{docId} {
      allow read: if isMpMember();
      allow write: if isMpAdmin();
    }

    // Listing and reply templates: shared ones readable by all, owners/managers edit.
    match /mp_templates/{id} {
      allow read: if isMpMember();
      allow create: if isMpMember() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isMpMember() && (resource.data.createdBy == request.auth.uid || isMpManager());
    }

    // Import connectors; credentials are in mp_integration_secrets and only functions read them.
    match /mp_integrations/{id} {
      allow read: if isMpManager();
      allow write: if isMpAdmin();
    }
    match /mp_integration_secrets/{id} {
      allow read: if false;
      allow create, update, delete: if isMpAdmin();
    }

    // Tracked short links (clicks are counted by the mpLink function).
    match /mp_links/{code} {
      allow read: if isMpMember();
      allow create: if isMpMember() && request.resource.data.userId == request.auth.uid &&
                       request.resource.data.clicks == 0;
      allow delete: if isMpManager();
    }
    match /mp_clicks/{id} {
      allow read: if isMpManager() || (isMpMember() && resource.data.userId == request.auth.uid);
    }

    // Public mini-storefronts (served publicly by the mpStorefrontApi function).
    // Members save drafts (published false); only a manager can make a storefront public.
    // The "tigon" address is reserved for the company storefront (admins).
    function storefrontPublishOk() {
      return request.resource.data.get('published', false) != true || isMpManager();
    }
    match /mp_storefronts/{slug} {
      allow read: if isMpMember();
      allow create: if isMpMember() && request.resource.data.userId == request.auth.uid &&
                       storefrontPublishOk() && (slug != 'tigon' || isMpAdmin());
      allow update: if isMpMember() && (resource.data.userId == request.auth.uid || isMpManager()) &&
                       request.resource.data.userId == resource.data.userId && storefrontPublishOk();
      allow delete: if isMpMember() && (resource.data.userId == request.auth.uid || isMpManager());
    }

    // Leads: owners and managers.
    match /mp_leads/{id} {
      allow read: if isMpManager() || (isMpMember() && resource.data.ownerUid == request.auth.uid);
      allow create: if isMpMember() && (request.resource.data.ownerUid == request.auth.uid || isMpManager());
      allow update: if isMpManager() ||
                       (isMpMember() && resource.data.ownerUid == request.auth.uid &&
                        request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isMpManager();
    }

    // Customers (opt-in consent tracked per channel), shared by the team.
    match /mp_customers/{id} {
      allow read, create, update: if isMpMember();
      allow delete: if isMpManager();
    }

    // Goals set by managers.
    match /mp_goals/{id} {
      allow read: if isMpMember();
      allow write: if isMpManager();
    }

    // Brand asset library.
    match /mp_assets/{id} {
      allow read: if isMpMember();
      allow write: if isMpManager();
    }

    // Facebook posting accounts.
    match /mp_accounts/{accountId} {
      allow read: if isMpMember();
      allow write: if isMpAdmin();
    }

    // ---- Sell more release (speed to lead, texting, quotes, booking, trade-ins, referrals…) ----------
    // Texts: anyone on the team may queue a text in their own name (salesData.sendText); delivery and
    // status are server-only. Only kinds a PERSON sends from the app are allowed (automatic kinds —
    // auto_lead, missed_call, cadence, price_drop, similar, no_show, service, reply — come from the server),
    // to be sent now (no scheduling into the future), with a fixed set of fields.
    match /mp_sms/{id} {
      allow read: if isMpManager() ||
                     (isMpMember() && (resource.data.createdBy == request.auth.uid || resource.data.ownerUid == request.auth.uid));
      allow create: if isMpMember() && request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.status == 'queued' &&
                       request.resource.data.kind in ['manual', 'quote', 'appointment', 'trade_in', 'prequal', 'referral'] &&
                       request.resource.data.keys().hasOnly(['to', 'body', 'kind', 'storeId', 'createdBy', 'status', 'sendAt',
                         'attempts', 'createdAt', 'leadId', 'customerId', 'queueAt']) &&
                       request.resource.data.sendAt is number &&
                       request.resource.data.sendAt <= request.time.toMillis() + 5 * 60 * 1000 &&
                       request.resource.data.get('attempts', 0) == 0 &&
                       request.resource.data.to is string && request.resource.data.to.matches('^[+]1[0-9]{10}$') &&
                       request.resource.data.body is string && request.resource.data.body.size() > 0 &&
                       request.resource.data.body.size() <= 1200;
    }
    match /mp_sms_optout/{phone} {
      allow read: if isMpMember();
      allow write: if isMpManager();
    }
    match /mp_sms_inbound/{id} {
      allow read: if isMpMember();
    }
    // Follow-up to-dos: owners work their own, managers everyone's.
    match /mp_tasks/{id} {
      allow read: if isMpManager() || (isMpMember() && resource.data.ownerUid == request.auth.uid);
      allow create: if isMpMember() && (request.resource.data.ownerUid == request.auth.uid || isMpManager());
      allow update: if isMpManager() ||
                       (isMpMember() && resource.data.ownerUid == request.auth.uid &&
                        request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isMpManager();
    }
    // Quotes (public view at /q/{code} goes through mpSalesPublic).
    match /mp_quotes/{code} {
      allow read: if isMpMember();
      allow create: if isMpMember() && request.resource.data.salespersonUid == request.auth.uid;
      allow update: if isMpMember() && (resource.data.salespersonUid == request.auth.uid || isMpManager());
      allow delete: if isMpManager();
    }
    // Appointments, trade-ins, pre-qualifications: the whole team works them.
    match /mp_appointments/{id} {
      allow read, create, update: if isMpMember();
      allow delete: if isMpManager();
    }
    match /mp_trade_ins/{id} {
      allow read, create, update: if isMpMember();
      allow delete: if isMpManager();
    }
    match /mp_prequal/{id} {
      allow read, create, update: if isMpMember();
      allow delete: if isMpManager();
    }
    // Referral codes: team creates them; rewards are counted by the server, managers mark them paid.
    match /mp_referrals/{code} {
      allow read: if isMpMember();
      allow create: if isMpMember() && request.resource.data.leads == 0 && request.resource.data.sales == 0 &&
                       request.resource.data.rewardsOwed == 0 && request.resource.data.rewardsPaid == 0;
      allow update: if isMpManager();
      allow delete: if isMpManager();
    }
    match /mp_price_changes/{id} {
      allow read: if isMpMember();
    }
    match /mp_reviews/{id} {
      allow read: if isMpMember();
    }

    // Credit applications (written only by the mpCreditApi function; team reads and sets status).
    match /mp_credit_apps/{id} {
      allow read: if isMpMember();
      allow update: if isMpMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isMpManager();
    }
    // Texts inbox: each person's "last read" marker per conversation.
    match /mp_inbox_reads/{id} {
      allow read: if isMpMember() && resource.data.uid == request.auth.uid;
      allow create, update: if isMpMember() && request.resource.data.uid == request.auth.uid &&
                               id.matches(request.auth.uid + '_[0-9]{11}') &&
                               request.resource.data.keys().hasOnly(['uid', 'phone', 'readAt']);
    }

    // ---- Webhook Flows (website forms → flows) -----------------------------
    // Managers run websites, webhooks, flows and email templates; admins own global settings and
    // integrations. Submissions and step runs are written only by Cloud Functions.
    match /wh_domains/{id} {
      allow read, write: if isMpManager();
    }
    match /wh_webhooks/{id} {
      allow read, write: if isMpManager();
    }
    match /wh_flows/{id} {
      allow read: if isMpManager();
      // Only admins may change the Master Flow (every lead passes through it).
      allow create: if isMpAdmin() || (isMpManager() && request.resource.data.type != 'master');
      allow update: if isMpAdmin() ||
                       (isMpManager() && resource.data.type != 'master' && request.resource.data.type != 'master');
      allow delete: if isMpAdmin() || (isMpManager() && resource.data.type != 'master');
    }
    match /wh_email_templates/{id} {
      allow read, write: if isMpManager();
    }
    match /wh_submissions/{id} {
      allow read: if isMpManager();
      // Managers may flag a lead (spam / not spam, notes); the engine owns everything else.
      allow update: if isMpManager() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['isSpam', 'spamReason', 'status', 'notes', 'reviewedBy', 'reviewedAt']);
      allow delete: if isMpAdmin();
    }
    match /wh_step_runs/{id} {
      allow read: if isMpManager();
    }
    match /wh_stats/{id} {
      allow read: if isMpManager();
    }
    match /wh_settings/{id} {
      allow read: if isMpManager();
      allow write: if isMpAdmin();
      // System Triage: managers may delete (hide) / bring back notifications.
      allow create, update: if id == 'triage' && isMpManager() &&
                               request.resource.data.keys().hasOnly(['dismissed', 'updatedAt', 'updatedBy']) &&
                               request.resource.data.dismissed is map;
    }
    match /wh_integrations/{id} {
      allow read: if isMpManager();
      allow write: if isMpAdmin();
    }
    // Credentials: write-only from the app, read only by Cloud Functions. Managers may set the
    // HMAC signing secret of a webhook (id "webhook_<webhookId>").
    match /wh_integration_secrets/{id} {
      // Webhook signing secrets can be viewed/copied by managers (webhook detail page); integration logins can't.
      allow read: if isMpManager() && id.matches('webhook_[A-Za-z0-9]+');
      allow create, update, delete: if isMpAdmin() || (isMpManager() && id.matches('webhook_.*'));
    }
    match /wh_sheet_buffer/{id} {
      allow read, write: if false;
    }
    match /wh_rate/{id} {
      allow read, write: if false;
    }
  }
}